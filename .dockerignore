# Keep the build context small: data and generated output are mounted at run
# time, never copied into the image.
.git
.github
.venv
.pytest_cache
.ruff_cache
**/__pycache__
data
# Except the raw data's DVC pointer (the test image's test_versioning.py).
!data/raw.dvc
reports/figures
reports/videos
reports/summaries
outputs/*
.jax_cache
models
mlruns.db
mlruns
mlartifacts
mlflow/*
Dockerfile
docker-compose.yml
