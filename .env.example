# Copy to .env (gitignored) to override the defaults in docker-compose.yml.
# The defaults are fine for local development; they are NOT for anything
# reachable from outside your machine.

# Container user for the bind-mounted services (match `id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000

POSTGRES_PASSWORD=mlflow
S3_ACCESS_KEY=mlflow
S3_SECRET_KEY=mlflow-secret
